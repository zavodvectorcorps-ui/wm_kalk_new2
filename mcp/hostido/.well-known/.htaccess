RewriteEngine On
RewriteRule ^oauth-authorization-server$ oauth-authorization-server.json [L]
RewriteRule ^oauth-protected-resource$ oauth-protected-resource.json [L]

# Fallback: force JSON for everything in this folder (only the metadata files live here).
ForceType application/json
<IfModule mod_headers.c>
  Header always set Access-Control-Allow-Origin "*"
</IfModule>
